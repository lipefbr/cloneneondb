// Database hosting platform schema (neon.tech-style)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  plan         String     @default("free") // free | pro | enterprise
  role         String     @default("user") // user | admin
  status       String     @default("active") // active | suspended | banned
  avatarUrl    String?
  company      String?
  trialEndsAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  projects     Project[]
  apiKeys      ApiKey[]
  activities   ActivityLog[]
  payments     Payment[]
  invoices     Invoice[]
}

model Payment {
  id           String   @id @default(cuid())
  userId       String
  amount       Float    // in BRL
  currency     String   @default("BRL")
  status       String   @default("pending") // pending | paid | failed | refunded
  method       String   @default("pix") // pix | card | boleto
  plan         String   // free | pro | enterprise
  period       String   @default("monthly") // monthly | yearly
  provider     String   @default("manual") // manual | stripe | mercadopago | pagseguro
  providerId   String?  // transaction id from provider
  createdAt    DateTime @default(now())
  paidAt       DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String
  paymentId   String
  number      String   @unique
  amount      Float
  status      String   @default("pending") // pending | paid | canceled
  dueDate     DateTime
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model PlanConfig {
  id           String  @id @default(cuid())
  plan         String  @unique // free | pro | enterprise
  name         String
  priceMonthly Float   @default(0)
  priceYearly  Float   @default(0)
  active       Boolean @default(true)
  // Quotas
  maxProjects          Int @default(1)
  maxBranchesPerProject Int @default(2)
  maxStorageMb         Int @default(100)
  maxConnections       Int @default(5)
  maxApiKeys           Int @default(2)
  maxQueryRows         Int @default(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Project {
  id          String   @id @default(cuid())
  name        String
  userId      String
  region      String   @default("us-east-1")
  pgVersion   String   @default("16")
  size        String   @default("0 MB")
  status      String   @default("active") // active | creating | paused
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches    Branch[]
  activities  ActivityLog[]
}

model Branch {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  parentBranchId  String?
  isDefault       Boolean  @default(false)
  status          String   @default("ready")
  createdAt       DateTime @default(now())

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          Branch?  @relation("BranchParent", fields: [parentBranchId], references: [id])
  children        Branch[] @relation("BranchParent")
  connections     Connection[]
}

model Connection {
  id            String   @id @default(cuid())
  branchId      String
  role          String   @default("neondb")    // real Postgres role name
  password      String                            // real Postgres password
  database      String   @default("neondb")    // real Postgres database name
  host          String   @default("localhost")
  port          Int      @default(5432)
  connectionUri String                          // full postgresql:// URI
  pooled        Boolean  @default(false)
  createdAt     DateTime @default(now())

  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  key       String   @unique
  userId    String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id])
  projectId String?
}
